{
  "expo": {
    "name": "BimodalApp",
    "slug": "bimodalapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0E1A"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.cla2004.bimodalapp",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0E1A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-fast-tflite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your videos for deepfake analysis."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "d4bd9845-2cca-4a89-91bc-d35665283298"
      }
    },
    "owner": "blckzr"
  }
}
